root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
charset = utf-8

[*.{csproj,props,targets,xml}]
indent_style = space
indent_size = 2
charset = utf-8

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2
charset = utf-8

[*.md]
trim_trailing_whitespace = false
charset = utf-8
