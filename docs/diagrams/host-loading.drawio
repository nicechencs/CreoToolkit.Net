        <mxCell id="native_2" value="Native 入口：DllMain → user_initialize → CLR" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#1B2438;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="36" as="geometry"/></mxCell>
