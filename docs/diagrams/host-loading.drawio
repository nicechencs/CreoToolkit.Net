        <mxCell id="appload_2" value="应用装配：NoOpApp / LoadFrom / AssemblyResolve / SampleCatalog" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#1B2438;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry"/></mxCell>
