        <mxCell id="managed_27" value="Requested" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;strokeColor=#1A7A4C;" edge="1" parent="1" source="managed_19" target="managed_25"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="managed_28" value="off" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="managed_19" target="managed_26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="managed_29" value="HostStartupOptions&lt;br/&gt;CreoApplicationLoader&lt;br/&gt;CreateLoadedFromEnvironment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A7A4C;strokeColor=#0F5A36;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="400" y="740" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="managed_30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="managed_25" target="managed_29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="managed_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;dashed=1;dashPattern=8 8;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="managed_26" target="managed_29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="managed_32" value="CreoAppHost.ForHost&lt;br/&gt;+ Run()&lt;br/&gt;命令/菜单/OnInitialize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A7A4C;strokeColor=#0F5A36;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="740" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="managed_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="managed_29" target="managed_32"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="managed_34" value="[可选] RunAppActions&lt;br/&gt;CTK_APP_RUN_COMMAND&lt;br/&gt;诊断 Ribbon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3E5FBB;strokeColor=#2C4A96;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="860" width="280" height="70" as="geometry"/></mxCell>
        <mxCell id="managed_35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="managed_32" target="managed_34"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="managed_36" value="返回 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F6EE;strokeColor=#1A7A4C;fontColor=#0F5A36;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="970" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="managed_37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="managed_34" target="managed_36"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="managed_38" value="任意异常&lt;br/&gt;&lt;br/&gt;写 managed-init-failure.txt&lt;br/&gt;DisposeManagedHost()&lt;br/&gt;返回 -1&lt;br/&gt;&lt;br/&gt;（Initialize / Terminate&lt;br/&gt;失败不二次 Dispose）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDECEC;strokeColor=#C0392B;fontColor=#7B1D1D;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1140" y="740" width="300" height="160" as="geometry"/></mxCell>
        <mxCell id="managed_39" value="抛" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;strokeColor=#C0392B;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="managed_32" target="managed_38"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="managed_40" value="Diagnostics 开关（DiagnosticsActivation）&lt;br/&gt;&lt;br/&gt;• CTK_DIAGNOSTICS_ENABLED=0/off/false/no → 强制关，即使遗留变量仍在。&lt;br/&gt;• 否则若 ENABLED=on、REQUIRED=on，或遗留 CTK_APP_PRELOAD_MODEL / LOAD_MODEL_PATH / RUN_COMMAND / LOAD_RIBBON 非空 → Requested。&lt;br/&gt;• launch.ps1 仅在传入 -Model 或已有 CTK_HOST_SMOKE_MODEL / CTK_APP_LOAD_MODEL_PATH 时预载模型并因此打开诊断。&lt;br/&gt;• PrepareSession / RunAppActions 标了 NoInlining：Diagnostics.dll 缺失时不毒化 JIT；REQUIRED=1 才把可选失败升级为启动失败。&lt;br/&gt;• Host 对 Diagnostics 有硬项目引用，Stage 总会拷贝该 DLL。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1500" height="220" as="geometry"/></mxCell>
        <mxCell id="managed_41" value="EnsureSession 细节&lt;br/&gt;&lt;br/&gt;1. 必须在 Creo initialize 线程（CreoThread）&lt;br/&gt;2. 再次 EnsureSharedAssemblyResolve&lt;br/&gt;3. NativeHostModule.EnsureLoaded：SetDllDirectoryW + AddDllDirectory + LoadLibraryW&lt;br/&gt;   目标 CTK_HOST_NATIVE_DLL 或 ../native/CreoToolkit.NativeHost.dll（进程内已加载的同一 DLL，非第二份插件）&lt;br/&gt;4. CreoSession.Attach() → CtkAbi.Verify 逐项校核结构体尺寸/offset（首个真实 P/Invoke）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="1500" height="180" as="geometry"/></mxCell>
        <mxCell id="managed_42" value="in-tree 触发对照&lt;br/&gt;&lt;br/&gt;Initialize / InitializeAndAttach：无 start-*.bat 设置；仅测试或手工环境变量。&lt;br/&gt;InitializeApp + NoOpApp：两套 CTK_APP_* 都空。deploy launcher 总会设置它们，故 start.bat 不是这条。&lt;br/&gt;InitializeApp + Core：start.bat / start-protk-samples-core.bat → ProtkSimpleSamplesCoreApp。&lt;br/&gt;InitializeApp + WinForms：start-protk-samples-winforms.bat → ProtkSimpleSamplesApp。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1520" width="1500" height="180" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
