        <mxCell id="appload_31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="appload_27" target="appload_28"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="appload_32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="appload_28" target="appload_29"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="appload_33" value="Stage 产物与加载对应关系&lt;br/&gt;&lt;br/&gt;deploy/native/CreoToolkit.NativeHost.dll     ← Creo LoadLibrary（唯一 native）&lt;br/&gt;deploy/native/protk.host.dat                 ← 模板；launcher 物化成 WorkDir/protk.dat&lt;br/&gt;deploy/managed/CreoToolkit.Host.dll          ← ExecuteInDefaultAppDomain&lt;br/&gt;deploy/managed/{Sdk,Interop,App,Diagnostics}.dll  ← AssemblyResolve 共享副本&lt;br/&gt;deploy/apps/protk-samples-core/*.dll         ← CTK_APP_ASSEMBLY（Core）&lt;br/&gt;deploy/apps/protk-samples-winforms/*.dll     ← CTK_APP_ASSEMBLY（WinForms）&lt;br/&gt;&lt;br/&gt;Terminate 不卸载程序集。同进程不承诺再 LoadFrom 另一个 app（InitializeApp 重入 -1）。要换 app 就重启 Creo。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="1500" height="240" as="geometry"/></mxCell>
        <mxCell id="appload_34" value="默认 AppDomain 驻留内容（进程级）&lt;br/&gt;&lt;br/&gt;Host · 可选 Diagnostics · App 契约 · Sdk · Interop · Polyfills · Serilog · 外部 ICreoApplication 及其 Module&lt;br/&gt;&lt;br/&gt;不在主加载链、按 app 需要加载：CreoToolkit.Agent / Agent.Client（命名管道 verb）。&lt;br/&gt;&lt;br/&gt;P/Invoke 库名永远是 CreoToolkit.NativeHost（已由 Creo 注册加载的那一颗）。exports.def 再导出约 5900 个 Pro*，让 Generated Pro*.g.cs 解析到同一 DLL。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1360" width="1500" height="260" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="apprun" name="5. CreoAppHost.Run · 命令注册">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1680" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="apprun_2" value="CreoAppHost.Run：命令硬失败、菜单可降级" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#1B2438;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="36" as="geometry"/></mxCell>
        <mxCell id="apprun_3" value="源码：src/CreoToolkit.App/CreoAppHost.cs。必须在 Creo 主线程；Run 只能尝试一次。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="apprun_4" value="CreoAppHost.Run()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A7A4C;strokeColor=#0F5A36;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="apprun_5" value="app.Initialize(builder)&lt;br/&gt;只声明命令/菜单/Ribbon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontColor=#1B2438;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="190" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="apprun_6" value="builder.BuildDefinition()&lt;br/&gt;校验菜单 commandName" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontColor=#1B2438;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="280" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="apprun_7" value="CommandDispatchPin&lt;br/&gt;钉住单一 native dispatch&lt;br/&gt;Ctk_CommandBridgeInitialize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0F2340;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="300" height="70" as="geometry"/></mxCell>
        <mxCell id="apprun_8" value="可选 CommandCapacityReserve" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontColor=#1B2438;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="460" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="apprun_9" value="CommandRegistrationRuntime&lt;br/&gt;Ctk_CommandActionAdd +&lt;br/&gt;ProCmdDesignate（硬失败）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0F2340;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="540" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="apprun_10" value="菜单外观（可降级 WARN）&lt;br/&gt;顶级菜单 → 子菜单 → 按钮&lt;br/&gt;→ option/check/radio → Ribbon" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontColor=#1B2438;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="650" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="apprun_11" value="session≠null → OnInitialize(ctx)&lt;br/&gt;成功后 _lifecycleInitialized=true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A7A4C;strokeColor=#0F5A36;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="770" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="apprun_12" value="host.init.ok · 等待点击" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F6EE;strokeColor=#1A7A4C;fontColor=#0F5A36;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="880" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="apprun_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="apprun_4" target="apprun_5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apprun_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="apprun_5" target="apprun_6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apprun_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="apprun_6" target="apprun_7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apprun_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="apprun_7" target="apprun_8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apprun_17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="apprun_8" target="apprun_9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apprun_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="apprun_9" target="apprun_10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apprun_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="apprun_10" target="apprun_11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apprun_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="apprun_11" target="apprun_12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="apprun_21" value="ICreoApplication 生命周期&lt;br/&gt;&lt;br/&gt;1. Initialize(builder) — 声明期，不要持有短命 native 资源&lt;br/&gt;2. Run 注册成功后 OnInitialize — 可订阅事件 / 启资源&lt;br/&gt;3. 仅 OnInitialize 完整返回后，停止时才配对 OnTerminate&lt;br/&gt;4. OnTerminate 在 BridgeTerminate 与 Session.Dispose 之前，session 仍可用" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="420" height="200" as="geometry"/></mxCell>
        <mxCell id="apprun_22" value="失败点回滚（F1–F5）&lt;br/&gt;&lt;br/&gt;F1 Initialize 抛：无资源 → Dispose session&lt;br/&gt;F2 BridgeInitialize 失败：BridgeTerminate → pin → registry&lt;br/&gt;F3 第 N 条 CommandActionAdd 失败：同 F2（前 N-1 已进 Creo 路由表）&lt;br/&gt;F4 菜单失败：命令已成功；WARN 继续，不撤销命令&lt;br/&gt;F5 OnInitialize 抛：不调 OnTerminate（与构造器异常语义一致）&lt;br/&gt;&lt;br/&gt;F5 前 app 自己产生的副作用必须自行回滚。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="980" y="190" width="460" height="280" as="geometry"/></mxCell>
        <mxCell id="apprun_23" value="命令回调返回码（不让托管异常穿过 native）&lt;br/&gt;&lt;br/&gt;0 成功（默认 message bar 回显 [ctk] done: &lt;cmd&gt;）&lt;br/&gt;1 handler 抛异常（LastFailedToken 记录 token）&lt;br/&gt;2 命令名/token 未注册&lt;br/&gt;&lt;br/&gt;CTK_DISPATCH_ECHO=0 可关回显。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="980" y="500" width="460" height="200" as="geometry"/></mxCell>
        <mxCell id="apprun_24" value="WinForms vs Core 注册差异&lt;br/&gt;&lt;br/&gt;两者都走 SampleModuleCatalog.RegisterAll（24 个模块，Order 锁定）。&lt;br/&gt;&lt;br/&gt;Core：模块自带的原生 Creo 菜单（如 ExtCreoMenu）仍注册；没有 7 个主题 dialog。适合 nogui / 集成。&lt;br/&gt;WinForms：同样 RegisterAll，再加 7 个 ctk.dialog.* launcher + MetadataCatalogBuilder + WinForms/WPF 桥 + MenuAdd(&quot;CreoToolkit&quot;）。&lt;br/&gt;命令元数据 116 条普通命令（109 模块 + 7 launcher）；ExtCreoMenu 的 option command 另计。&lt;br/&gt;&lt;br/&gt;CreoAppBuilder.LoadCustomRibbon 与 CTK_APP_LOAD_RIBBON 最终都调 ProRibbonDefinitionfileLoad。当前 ExtCreoMenu sample 跳过二进制 .rbn，默认 sample 不能称为「已装自定义 Ribbon」。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="980" width="1420" height="280" as="geometry"/></mxCell>
        <mxCell id="apprun_25" value="点击之后（加载完成后的运行时，非启动链）&lt;br/&gt;&lt;br/&gt;Creo 菜单点击 → NativeHost 内 SEH trampoline（Ctk_CommandActionAdd）&lt;br/&gt;→ 钉住的 CommandDispatchPin 函数指针&lt;br/&gt;→ CreoAppHost 按 token 找到 handler&lt;br/&gt;→ SessionCommandDispatcher 保证主线程&lt;br/&gt;→ ICreoApplication 注册的 lambda / Module Registration&lt;br/&gt;→ L3 Sdk 对象模型 → L2 P/Invoke → 同一颗 NativeHost.dll 内 Pro* / Ctk_*&lt;br/&gt;&lt;br/&gt;Agent 路径（可选）：外部进程 NamedPipeAgentClient → NamedPipeAgentServer → MainThreadAgentExecutor → CreoCommandRouter。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1280" width="1420" height="320" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="terminate" name="6. 停止 · user_terminate">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1580" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="terminate_2" value="停止与卸载：处置对象，不卸 CLR / 不卸 DLL" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=20;fontStyle=1;fontColor=#1B2438;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="36" as="geometry"/></mxCell>
        <mxCell id="terminate_3" value="源码：host_entry.cpp user_terminate · Bootstrap.Terminate / DisposeManagedHost · CreoAppHost.Dispose。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#5A6478;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1300" height="28" as="geometry"/></mxCell>
        <mxCell id="terminate_4" value="Creo 调用 user_terminate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DD6A2B;strokeColor=#B45309;fontColor=#FFFFFF;fontStyle=1;fontFamily=Microsoft YaHei;fontSize=13;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="300" height="50" as="geometry"/></mxCell>
        <mxCell id="terminate_5" value="重入守卫 g_user_terminate_entered&lt;br/&gt;第二次 → WARN no-op" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBEADC;strokeColor=#DD6A2B;fontColor=#1B2438;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="190" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="terminate_6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="terminate_4" target="terminate_5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_7" value="重复调用直接返回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F6EE;strokeColor=#1A7A4C;fontColor=#0F5A36;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="190" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="terminate_8" value="已进入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;strokeColor=#C0392B;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="terminate_5" target="terminate_7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_9" value="clr_host::is_started() ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FBEADC;strokeColor=#DD6A2B;fontColor=#1B2438;fontFamily=Microsoft YaHei;fontSize=11;" vertex="1" parent="1"><mxGeometry x="540" y="290" width="340" height="60" as="geometry"/></mxCell>
        <mxCell id="terminate_10" value="首次" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="terminate_5" target="terminate_9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_11" value="从未 Start → 跳过托管 Terminate&lt;br/&gt;避免退出路径冷启动 CLR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="290" width="280" height="50" as="geometry"/></mxCell>
        <mxCell id="terminate_12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="terminate_9" target="terminate_11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_13" value="invoke_managed(&quot;Terminate&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B2C6F;strokeColor=#3D1B4D;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="390" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="terminate_14" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="terminate_9" target="terminate_13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_15" value="DisposeManagedHost&lt;br/&gt;必须在 Creo initialize 线程&lt;br/&gt;拒绝则两边 owner 都保留" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3E5FBB;strokeColor=#2C4A96;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="480" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="terminate_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="terminate_13" target="terminate_15"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_17" value="appHost.Dispose()&lt;br/&gt;OnTerminate（仅 _lifecycleInitialized）&lt;br/&gt;BridgeTerminate + pin.Dispose&lt;br/&gt;清 _cmds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A7A4C;strokeColor=#0F5A36;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="590" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="terminate_18" value="session.Dispose()&lt;br/&gt;CallbackRegistry / 句柄&lt;br/&gt;主线程释放门 / adopted handle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0E7490;strokeColor=#155E75;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="720" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="terminate_19" value="静态字段置 null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6c8ebf;fontColor=#1B2438;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="830" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="terminate_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="terminate_15" target="terminate_17"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="terminate_17" target="terminate_18"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="terminate_18" target="terminate_19"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_23" value="native：可选 ETW shutdown&lt;br/&gt;写 session.end&lt;br/&gt;不 ICLRRuntimeHost::Stop&lt;br/&gt;不 FreeLibrary NativeHost.dll" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0F2340;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="920" width="340" height="90" as="geometry"/></mxCell>
        <mxCell id="terminate_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="terminate_19" target="terminate_23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_25" value="继续 native 收尾" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;dashed=1;dashPattern=8 8;strokeColor=#6c8ebf;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="terminate_11" target="terminate_23"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_26" value="DLL_PROCESS_DETACH&lt;br/&gt;loader lock 下不做 IO&lt;br/&gt;NativeHost 按进程寿命设计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B365D;strokeColor=#0F2340;fontColor=#FFFFFF;fontFamily=Microsoft YaHei;fontSize=12;arcSize=8;" vertex="1" parent="1"><mxGeometry x="540" y="1050" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="terminate_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#3A4560;strokeWidth=1.4;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#3A4560;" edge="1" parent="1" source="terminate_23" target="terminate_26"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="terminate_28" value="明确不做的事&lt;br/&gt;&lt;br/&gt;• 不 Stop CLR 4（一进程一套，可能已有其他宿主）&lt;br/&gt;• 不卸载默认 AppDomain 程序集&lt;br/&gt;• NativeHost.dll 不主动 FreeLibrary&lt;br/&gt;• 无命令 unregister/re-register 契约&lt;br/&gt;• 不承诺同进程热重载&lt;br/&gt;• 多实例会互相覆盖 CTK_HOST_*（不支持）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="440" height="280" as="geometry"/></mxCell>
        <mxCell id="terminate_29" value="init 失败 vs 正常停止&lt;br/&gt;&lt;br/&gt;Creo 对 user_initialize 非零通常不调 user_terminate。&lt;br/&gt;因此 RunEntry（除 Initialize/Terminate）失败时&lt;br/&gt;必须自己 DisposeManagedHost，否则泄漏。&lt;br/&gt;&lt;br/&gt;finish_user_initialize(非0) 会关 ETW、写 session.end。&lt;br/&gt;托管 Terminate 失败不阻断 native 收尾。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="390" width="480" height="280" as="geometry"/></mxCell>
        <mxCell id="terminate_30" value="证据与日志落点（加载/停止可观测性）&lt;br/&gt;&lt;br/&gt;DllMain attach：%LOCALAPPDATA%\CreoToolkit\ctk-attach-p{pid}.log（单条 JSONL，无 traceId）&lt;br/&gt;user_initialize JSONL / pointer：CTK_BOOTSTRAP_LOG_DIR（launcher 设为 WorkDir\logs）&lt;br/&gt;托管文件日志：CTK_HOST_MANAGED_LOG → WorkDir\logs\host-managed.log（session.start 边界）&lt;br/&gt;托管总开关：CTK_DOTNET_LOG / LEVEL / FORMAT / FILE&lt;br/&gt;失败兜底：managed-init-failure.txt（与 bootstrap 同目录）&lt;br/&gt;handoff ACK：native 仍导出 ctk_native_log_handoff_ack 作 ABI stub；当前 Host 不再 P/Invoke，加载不等待 ack。&lt;br/&gt;&lt;br/&gt;旧 host-marker-*.log / host-native-*.log / CTK_LOG* 已停用或仅迁移期 fallback。" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F8FC;strokeColor=#B9C2D6;fontColor=#3A4560;align=left;verticalAlign=top;fontFamily=Microsoft YaHei;fontSize=11;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="1420" height="340" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
