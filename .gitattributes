# Auto-detect text/binary, normalize line endings on commit
* text=auto eol=lf

# ===== Force LF (cross-platform source) =====
*.cs           text eol=lf
*.csproj       text eol=lf
*.props        text eol=lf
*.targets      text eol=lf
*.slnx         text eol=lf
*.sln          text eol=lf
*.cpp          text eol=lf
*.cc           text eol=lf
*.cxx          text eol=lf
*.c            text eol=lf
*.h            text eol=lf
*.hpp          text eol=lf
*.def          text eol=lf
*.cmake        text eol=lf
CMakeLists.txt text eol=lf
*.md           text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.xml          text eol=lf
*.py           text eol=lf
*.ps1          text eol=lf
*.psm1         text eol=lf
*.psd1         text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# ===== Force CRLF (Windows-only batch) =====
*.cmd          text eol=crlf
*.bat          text eol=crlf

# ===== Binary =====
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.bmp    binary
*.dll    binary
*.exe    binary
*.pdb    binary
*.lib    binary
*.zip    binary
*.7z     binary
*.tar    binary
*.gz     binary
*.nupkg  binary
*.snupkg binary

# ===== Pre-generated bindings (committed; collapse in GitHub diff) =====
src/CreoToolkit.Interop/Generated/** linguist-generated=true
